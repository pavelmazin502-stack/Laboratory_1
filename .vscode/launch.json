{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: Отладка (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/lab_program",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Включить pretty-printing для GDB",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build-cpp",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}